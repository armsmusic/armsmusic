{# ===============================================================
   ARMS Music — cart-drawer.njk
   Carrito lateral (overlay + drawer).
   Capa visual migrada al estilo del cart-drawer de Impact
   (clases .cart-* en arms.css, §19): panel blanco flotante,
   paleta 26 26 26, bordes al 12%, botones .button button--xl.
   Funcionamiento intacto (decisión del dueño): mismos IDs,
   hooks, controles y textos — cart-drawer.js sigue siendo
   quien abre/cierra y renderiza los items.
   ================================================================ #}

<div id="cart-overlay" class="cart-overlay" onclick="cerrarCarrito()"></div>

<div id="cart-drawer" aria-label="Carrito de compras" class="cart-drawer">

  <!-- Pantalla 1: Carrito -->
  <div id="screen-cart" class="cart-drawer__screen">
    <div class="cart-drawer__header">
      <div class="cart-drawer__header-title">
        <h5 class="cart-drawer__title">Tu Carrito</h5>
        {# Burbuja de conteo (demo: count-bubble--md junto al título) #}
        <span id="cart-count-bubble" class="cart-drawer__count">0</span>
      </div>
      <button onclick="cerrarCarrito()" class="cart-drawer__close" aria-label="Cerrar carrito">
        {# × del demo (icon-close 24px, stroke 2) #}
        <svg role="presentation" stroke-width="2" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M17.658 6.343 6.344 17.657M17.658 17.657 6.344 6.343" stroke="currentColor"></path>
        </svg>
      </button>
    </div>
    <div id="cart-items" class="cart-drawer__body">
      <div id="cart-empty" class="cart-drawer__empty">
        <div class="cart-drawer__empty-icon">🛒</div>
        <p>Tu carrito está vacío</p>
        <button onclick="cerrarCarrito()" class="button button--xl cart-drawer__empty-btn">Ver productos</button>
      </div>
      <div id="cart-list" class="cart-drawer__list"></div>
      <div id="cart-stock-msg" class="cart-stock-msg"></div>
    </div>
    <div id="cart-footer" class="cart-drawer__footer">
      <div class="cart-drawer__total-row">
        <span class="cart-drawer__total-label">Total</span>
        <span id="cart-total" class="cart-drawer__total-value">Q0</span>
      </div>
      <button onclick="irACheckout()" class="button button--xl cart-drawer__checkout">
        Proceder al pago →
      </button>
    </div>
  </div>

</div>
