{# Todos los datos vienen del objeto prod (pagination alias) #}
{% set nombre        = prod.nombre %}
{% set precio        = prod.precio %}
{% set precioOriginal= prod.precioOriginal %}
{% set descuento     = prod.descuento %}
{% set g1            = prod.g1 %}
{% set g2            = prod.g2 %}
{% set svgTipo       = prod.svgTipo %}
{% set variantes     = prod.variantes %}
{% set subtitulo     = prod.subtitulo %}
{% set descripcion   = prod.descripcion %}
{% set seccion       = prod.seccion %}
{% set pilar         = prod.pilar %}
{% set relacionados  = prod.relacionados %}
{% set imagenes      = prod.imagenes %}
{% set imagenesVariantes = prod.imagenesVariantes %}
{# el bucle de relacionados hace {% set prod = rel %} y sobrescribe `prod`,
   así que el id de ESTA página se captura aquí, antes de ese bucle #}
{% set productoActualId  = prod.id %}

{# Pilar label y URL #}
{% if pilar == "in-ears" %}
  {% set pilarLabel = "In-Ears" %}
  {% set pilarUrl   = "/in-ears/" %}
{% elif pilar == "in-ears/accesorios" %}
  {% set pilarLabel = "Accesorios In-Ears" %}
  {% set pilarUrl   = "/in-ears/accesorios/" %}
{% elif pilar == "audio/sistemas" %}
  {% set pilarLabel = "Sistemas" %}
  {% set pilarUrl   = "/audio/sistemas/" %}
{% elif pilar == "audio/interfaces" %}
  {% set pilarLabel = "Interfaces" %}
  {% set pilarUrl   = "/audio/interfaces/" %}
{% elif pilar == "audio/microfonos" %}
  {% set pilarLabel = "Micrófonos" %}
  {% set pilarUrl   = "/audio/microfonos/" %}
{% elif pilar == "audio/cables" %}
  {% set pilarLabel = "Cables" %}
  {% set pilarUrl   = "/audio/cables/" %}
{% else %}
  {% set pilarLabel = "Audio" %}
  {% set pilarUrl   = "/audio/" %}
{% endif %}

{% set varId = ("var-" + nombre) | replace(" ", "-") | replace("/", "-") %}
{% set btnId = ("btn-add-" + nombre) | replace(" ", "-") | replace("/", "-") %}
{# el bucle de relacionados sobrescribe varId/btnId; el del producto
   se captura ya (mismo patrón que productoActualId) #}
{% set productoVarId = varId %}

{# dots de color para el picker de variantes (block-swatch) —
   mismos colores que el mapa `vs` de .eleventy.js #}
{% set varDots = {
  "Negro":   "#1a1a1a",
  "Verde":   "#10b981",
  "Crystal": "#38bdf8",
  "Gray":    "#9ca3af",
  "Purple":  "#a855f7",
  "Silver":  "#94a3b8",
  "Blue":    "#3b82f6",
  "Dorado":  "#d97706",
  "Blanco":  "#cbd5e1"
} %}

<div class="producto-page">

  <!-- BREADCRUMB -->
  <section class="pt-producto">
    <div class="container">
      <nav aria-label="Ruta de navegación" style="margin-bottom:1.5rem;">
        <ol class="breadcrumb-arms">
          <li><a href="/">Inicio</a></li>
          <li><span aria-hidden="true">›</span></li>
          <li><a href="{{ pilarUrl }}">{{ pilarLabel }}</a></li>
          <li><span aria-hidden="true">›</span></li>
          <li aria-current="page">{{ nombre }}</li>
        </ol>
      </nav>
    </div>
  </section>

  <!-- HERO DEL PRODUCTO — sin .container: en el demo la caja
       (section-boxed) lleva el padding y el grid ocupa todo el
       ancho interior (1248px en 1440) -->
  <section class="pb-producto">
      <div class="producto-layout">

        <!-- Galería -->
        <div>
          {% include "product-gallery.njk" %}

          {% if descuento %}
          <div class="arms-text-center" style="margin-top: var(--spacing-4);">
            <span class="badge-discount-lg">🔥 {{ descuento }} de descuento</span>
          </div>
          {% endif %}
        </div>

        <!-- Info — <safe-sticky>: mecanismo de sticky de Impact
             (position:sticky + compensación de scroll —
             safe-sticky.js / .producto-info en arms.css) -->
        <safe-sticky class="producto-info">

          <h1 class="producto-nombre">{{ nombre }}</h1>
          {% if subtitulo %}<p class="producto-subtitulo">{{ subtitulo }}</p>{% endif %}

          {# Precio — price-list del demo (price-list--lg + text-lg) #}
          <div class="producto-precio">
            <div class="price-list price-list--lg">
              {% if precioOriginal %}<s class="producto-precio-original">{{ precioOriginal | gtq }}</s>{% endif %}
              <span class="producto-precio-actual">{{ precio | gtq }}</span>
            </div>
          </div>

          <div class="stock-indicator" style="margin-bottom:1.25rem;"></div>

          <hr class="producto-separator">

          {% if variantes %}
          {# Picker de variantes — variant-picker del demo: swatch de
             imagen 60px si hay foto por variante, si no block-swatch
             (texto + dot de color). El onclick y .var-btn-active son
             hooks de cart-store.js (no tocar). #}
          <div class="variant-picker">
            <div class="variant-picker__option">
              <div class="variant-picker__option-info">
                <span class="text-subdued">Color / Versión:</span>
                <span class="producto-variante-actual">{{ variantes[0] }}</span>
              </div>
              <div class="variant-picker__option-values" id="{{ productoVarId }}">
                {% for varName in variantes %}
                {% set varImg = imagenesVariantes[varName] if imagenesVariantes[varName] else null %}
                {% if varImg %}
                <button
                  onclick="seleccionarVariante(this, '{{ nombre }}', '{{ varName }}', {{ precio }})"
                  data-img="/assets/img/productos/{{ varImg }}"
                  class="thumbnail-swatch{% if loop.first %} var-btn-active{% endif %}"
                  title="{{ varName }}" aria-label="{{ varName }}">
                  <img src="/assets/img/productos/{{ varImg }}" alt="{{ varName }}">
                </button>
                {% else %}
                <button
                  onclick="seleccionarVariante(this, '{{ nombre }}', '{{ varName }}', {{ precio }})"
                  data-img="/assets/img/productos/{{ imagenes[0] if imagenes[0] else '' }}"
                  class="block-swatch{% if loop.first %} var-btn-active{% endif %}"
                  style="--swatch-background: {{ varDots[varName] or '#9ca3af' }};"
                  title="{{ varName }}">
                  <span class="block-swatch__color" aria-hidden="true"></span>
                  {{ varName }}
                </button>
                {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>
          {% endif %}

          <div class="producto-acciones">
            {% if variantes %}
            <button
              class="button button--xl btn-agregar"
              id="{{ btnId }}"
              data-product-name="{{ nombre }} - {{ variantes[0] }}"
              data-img="/assets/img/productos/{{ imagenesVariantes[variantes[0]] if imagenesVariantes[variantes[0]] else imagenes[0] }}"
              onclick="agregarAlCarrito('{{ nombre }} - {{ variantes[0] }}', {{ precio }}, this)">
              <i class="fa-solid fa-cart-plus"></i> Agregar al carrito
            </button>
            {% else %}
            <button
              class="button button--xl btn-agregar"
              data-product-name="{{ nombre }}"
              data-img="/assets/img/productos/{{ imagenes[0] }}"
              onclick="agregarAlCarrito('{{ nombre }}', {{ precio }}, this)">
              <i class="fa-solid fa-cart-plus"></i> Agregar al carrito
            </button>
            {% endif %}
            <a href="https://wa.me/50234646667?text=Hola%2C%20me%20interesa%3A%20{{ nombre | urlencode }}%20(Q{{ precio }})"
              target="_blank" rel="noopener noreferrer"
              class="button button--xl btn-whatsapp-producto">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Consultar por WhatsApp
            </a>
          </div>

          <div class="producto-chips">
            <span class="chip"><i class="fa-solid fa-truck chip-icon"></i> Envío a toda Guatemala</span>
            <span class="chip"><i class="fa-solid fa-shield-halved chip-icon"></i> Garantía incluida</span>
            <span class="chip"><i class="fa-solid fa-rotate-left chip-icon"></i> Cambios y devoluciones</span>
          </div>

        </safe-sticky>
      </div>
  </section>

  {% if descripcion %}
  <section class="py-producto-sm">
    <div class="container">
      <div class="producto-descripcion-card">
        <h2 class="producto-section-title">Descripción</h2>
        <p class="producto-descripcion-texto">{{ descripcion | safe }}</p>
      </div>
    </div>
  </section>
  {% endif %}

  {% if relacionados and relacionados.length > 0 %}
  <section class="py-producto-sm">
    <div class="container">
      <h2 class="producto-section-title">También te puede interesar</h2>
      <div class="producto-relacionados">
        {% for rel in relacionados %}
        {% set relVarId = ("var-cat-" + rel.nombre) | replace(" ", "-") | replace("/", "-") %}
        {% set relBtnId = ("btn-cat-" + rel.nombre) | replace(" ", "-") | replace("/", "-") %}
        {% set relUrl   = rel.id | productoUrl %}
        {% set prod    = rel %}
        {% set prodUrl = rel.id | productoUrl %}
        {% set varId   = ("var-cat-" + rel.nombre) | replace(" ", "-") | replace("/", "-") %}
        {% set btnId   = ("btn-cat-" + rel.nombre) | replace(" ", "-") | replace("/", "-") %}
        {% include "card-producto.njk" %}
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <section class="py-producto-sm">
    <div class="container">
      <a href="{{ pilarUrl }}" class="btn-volver">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        Volver a {{ pilarLabel }}
      </a>
    </div>
  </section>

</div>

{# ── BARRA STICKY — botón "Agregar" fijo ───────────────────────
   Igual al demo de Impact: en móvil (<992px) el botón va a todo
   lo ancho abajo; en desktop una tarjeta compacta abajo-derecha
   (imagen + nombre + precio + botón). Aparece cuando el botón
   principal sale de pantalla (script al final de este include). #}
{% set imgBarra = (imagenesVariantes[variantes[0]] if (variantes and imagenesVariantes and imagenesVariantes[variantes[0]]) else imagenes[0]) %}
<div id="producto-barra" class="producto-barra">
  <img class="producto-barra__img" src="/assets/img/productos/{{ imgBarra }}" alt="{{ nombre }}">
  <span class="producto-barra__nombre">{{ nombre }}</span>
  <span class="producto-barra__precio">{{ precio | gtq }}</span>
  <button id="btn-barra-add" class="button button--xl producto-barra__btn"
    onclick="agregarDesdeBarra()">
    <i class="fa-solid fa-cart-plus"></i> Agregar al carrito
  </button>
</div>

{# ── FEATURED-COLLECTION ("Los más vendidos") ────────────────── #}
{% set fcTitulo = "Los más vendidos" %}
{% set fcCarouselId = "scroll-area-producto" %}
{% set fcIds = [
  "kz-castor-pro",
  "kz-zsn-pro-2",
  "kz-az09",
  "amplificador-ha-800",
  "p2-monitor-personal",
  "extension-5m-inears",
  "joyo-momix-cab",
  "kz-edx-pro",
  "kz-edx-lite",
  "amplificador-ha-400",
  "pm1-monitor-personal"
] %}
{% set fcFuente = productos.inears
  .concat(productos["accesorios-inears"])
  .concat(productos.monitores)
  .concat(productos["audio-interfaces"]) %}
{# no mostrar en el carrusel el producto que se está viendo #}
{% set fcExcluirId = productoActualId %}
{% include "pilar/featured-collection.njk" %}

{# ── TEXT-WITH-ICONS (garantías) ─────────────────────────────── #}
{% set twiCarouselId = "carousel-twi-producto" %}
{% include "pilar/text-with-icons.njk" %}

<script>
// Precio de ESTA página — lo usa la barra sticky móvil
// (el botón principal lleva el precio en su onclick inline)
var ARMS_PRODUCTO_PRECIO = {{ precio }};

// Barra sticky móvil: agrega al carrito la variante que está
// seleccionada en el botón principal (lee data-product-name en
// el momento del clic — siempre sincronizado con
// seleccionarVariante de cart-store.js, sin tocar ese archivo).
function agregarDesdeBarra() {
  var main  = document.querySelector('.producto-acciones .btn-agregar');
  var barra = document.getElementById('btn-barra-add');
  if (!main || !barra || main.disabled) return;
  var img = main.getAttribute('data-img');
  if (img) barra.setAttribute('data-img', img);
  agregarAlCarrito(main.getAttribute('data-product-name'), ARMS_PRODUCTO_PRECIO, barra);
}

(function () {
  var acciones = document.querySelector('.producto-acciones');
  var barra    = document.getElementById('producto-barra');
  if (!acciones || !barra) return;

  // En movil la barra flota ENCIMA del bottom-nav (que siempre se
  // queda a la vista): se apila por encima del elemento mas alto
  // del nav (su boton carrito sube con margin-top negativo). Se
  // mide en runtime para que sirva en iPhone (ahi el nav es mas
  // alto por el safe-area). En desktop la posicion la da el CSS
  // (tarjeta abajo-derecha).
  var barraBottom = 0;
  function posicionarBarra() {
    var main = document.querySelector('.producto-acciones .btn-agregar');
    var btn  = document.getElementById('btn-barra-add');
    if (window.innerWidth >= 992) {
      barra.style.bottom = '';
      barraBottom = 0;
      if (btn) btn.style.width = ''; // en desktop lo da el CSS (tarjeta)
      return;
    }
    // la pildora lleva el mismo ancho que el boton principal
    if (btn && main && main.offsetWidth) btn.style.width = main.offsetWidth + 'px';
    var nav  = document.getElementById('bottom-nav');
    if (!nav) return; // aun no se ha parseado (viene despues en el HTML)
    var cart = document.getElementById('btn-cart-bottom');
    var ref  = (cart && cart.offsetWidth) ? cart : nav;
    barraBottom = Math.ceil(window.innerHeight - ref.getBoundingClientRect().top) + 10;
    barra.style.bottom = barraBottom + 'px';
  }

  // Mostrar la barra cuando el bloque de botones queda por ARIBA
  // del viewport (r.bottom < 0); ocultarla cuando vuelve a ser
  // visible. Con IntersectionObserver no funciona: el elemento pasa
  // de "abajo del viewport" a "arriba" sin cruzar el umbral de
  // intersección (ratio 0 en ambos lados) y nunca dispara.
  function actualizarBarra() {
    var visible = acciones.getBoundingClientRect().bottom < 0;
    barra.classList.toggle('is-visible', visible);
    // el boton de WhatsApp sube mientras la barra esta a la vista
    // (en su posicion normal quedaria dentro de la zona de la
    // pildora). Se consulta en runtime: floating-ui viene despues
    // del main en el HTML, al correr el script no esta en el DOM.
    var waf = document.querySelector('.whatsapp-float');
    if (waf) {
      waf.style.bottom = (visible && window.innerWidth < 992)
        ? (barraBottom + barra.offsetHeight + 12) + 'px'
        : '';
    }
  }
  var ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function () {
      actualizarBarra();
      ticking = false;
    });
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', function () {
    posicionarBarra();
    onScroll();
  }, { passive: true });
  posicionarBarra();
  actualizarBarra();
  // la primera llamada (arriba) corre con el nav aun no parseado:
  // se repite cuando el DOM esta completo y el nav ya esta dibujado
  // (site-ui.js lo muestra en su propio DOMContentLoaded, que corre
  // antes de este rAF)
  document.addEventListener('DOMContentLoaded', function () {
    requestAnimationFrame(posicionarBarra);
  });

  // Sincronizar estado agotado con el botón principal
  var main = document.querySelector('.producto-acciones .btn-agregar');
  var btnBarra = document.getElementById('btn-barra-add');
  if (main && btnBarra) {
    new MutationObserver(function () {
      if (main.disabled) {
        btnBarra.disabled = true;
        btnBarra.style.opacity = '0.5';
        btnBarra.textContent = 'Agotado';
      } else {
        btnBarra.disabled = false;
        btnBarra.style.opacity = '1';
        btnBarra.innerHTML = '<i class="fa-solid fa-cart-plus"></i> Agregar al carrito';
      }
      // miniatura de la barra = imagen de la variante elegida
      var img = main.getAttribute('data-img');
      if (img) {
        var thumb = document.querySelector('.producto-barra__img');
        if (thumb) thumb.src = img;
      }
    }).observe(main, { attributes: true, attributeFilter: ['disabled', 'data-img'] });
  }
})();

// Etiqueta "Color / Versión: X" — se actualiza cuando cambia la
// variante (seleccionarVariante / autoSeleccionarVarianteDisponible
// de cart-store.js togglean .var-btn-active; se lee con observer
// para no tocar ese archivo).
(function () {
  var grupo = document.querySelector('.variant-picker__option-values');
  var label = document.querySelector('.producto-variante-actual');
  if (!grupo || !label) return;
  new MutationObserver(function () {
    var act = grupo.querySelector('.var-btn-active');
    if (!act) return;
    var m = (act.getAttribute('onclick') || '')
      .match(/seleccionarVariante\(this,\s*'[^']*',\s*'([^']*)'/);
    if (m) label.textContent = m[1];
  }).observe(grupo, { subtree: true, attributes: true, attributeFilter: ['class'] });
})();
</script>
