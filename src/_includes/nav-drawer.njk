{# ===============================================================
   ARMS Music — nav-drawer.njk
   Menú lateral de navegación (hamburguesa). Extraído de base.njk.

   2026-10-10: estilos del Impact (navigation-drawer del demo,
   medido en vivo con Playwright + theme.css/theme.js):
   - <700px: bottom-sheet full-width (margen 8px), alto máx 75vh,
     blanco, radius 6px, × circular 48px flotando encima centrado
   - ≥700px: drawer de la izquierda 412px (margen 16px), full-height,
     blanco, radius 6px, × circular 48px con borde DENTRO
     (arriba-izquierda)
   - Links h3 (24px) / h4 (26px ≥700 · 32px ≥1400) bold, gap 16px,
     subrayado animado al hover (reversed-link del demo)
   - Submenú Audio = acordeón (funcionalidad propia, intacta),
     sublinks h5
   - Footer con íconos sociales 27px (Facebook + WhatsApp)
   - Overlay negro 40% (igual al cart-drawer)
   - SIN logo (decisión del dueño 2026-10-10: 100% fiel al demo)

   JS: abrirMenuNav / cerrarMenuNav / toggleAudioSubmenu
   (site-ui.js). Mismos IDs, onclick y links que antes — solo la
   capa visual (los estilos inline oscuros viejos pasaron a clases
   .menu-nav-* en arms.css).
================================================================ #}

<div id="menu-nav-overlay" class="menu-nav-overlay" onclick="cerrarMenuNav()"></div>

<div id="menu-nav-drawer" class="menu-nav-drawer" aria-label="Menú de navegación">

  <!-- Cerrar: móvil — flota sobre la hoja (demo: outside-close-button) -->
  <button type="button" class="menu-nav-close menu-nav-close--float" onclick="cerrarMenuNav()" aria-label="Cerrar menú">
    <svg role="presentation" stroke-width="2" focusable="false" width="19" height="19" viewBox="0 0 24 24">
      <path d="M17.658 6.343 6.344 17.657M17.658 17.657 6.344 6.343" stroke="currentColor"></path>
    </svg>
  </button>

  <div class="menu-nav-panel">

    <!-- Cerrar: desktop — dentro del drawer (arriba-izquierda) -->
    <button type="button" class="menu-nav-close menu-nav-close--inline" onclick="cerrarMenuNav()" aria-label="Cerrar menú">
      <svg role="presentation" stroke-width="2" focusable="false" width="19" height="19" viewBox="0 0 24 24">
        <path d="M17.658 6.343 6.344 17.657M17.658 17.657 6.344 6.343" stroke="currentColor"></path>
      </svg>
    </button>

    <nav class="menu-nav-nav" aria-label="Navegación principal">
      <ul class="menu-nav-list" role="list">

        <li>
          <a href="/in-ears/" class="menu-nav-link" onclick="cerrarMenuNav()"><span class="menu-nav-link-text">In-Ears</span></a>
        </li>

        <li>
          <a href="/in-ears/accesorios/" class="menu-nav-link" onclick="cerrarMenuNav()"><span class="menu-nav-link-text">Accesorios</span></a>
        </li>

        <li>
          <a href="/audio/sistemas/" class="menu-nav-link" onclick="cerrarMenuNav()"><span class="menu-nav-link-text">Monitoreo</span></a>
        </li>

        <!-- Audio con acordeón -->
        <li>
          <button type="button" class="menu-nav-link menu-nav-link--parent" onclick="toggleAudioSubmenu()" aria-controls="audio-submenu" aria-expanded="false">
            <span>Audio</span>
            <span class="menu-nav-chevron">
              <svg id="audio-submenu-arrow" role="presentation" focusable="false" width="5" height="8" viewBox="0 0 5 8">
                <path d="m.75 7 3-3-3-3" fill="none" stroke="currentColor" stroke-width="1.5"></path>
              </svg>
            </span>
          </button>
          <ul id="audio-submenu" class="menu-nav-submenu" role="list" style="display:none">
            <li><a href="/audio/sistemas/" onclick="cerrarMenuNav()"><span class="menu-nav-link-text">Sistemas</span></a></li>
            <li><a href="/audio/interfaces/" onclick="cerrarMenuNav()"><span class="menu-nav-link-text">Interfaces</span></a></li>
            <li><a href="/audio/microfonos/" onclick="cerrarMenuNav()"><span class="menu-nav-link-text">Micrófonos</span></a></li>
            <li><a href="/audio/cables/" onclick="cerrarMenuNav()"><span class="menu-nav-link-text">Cables</span></a></li>
          </ul>
        </li>

      </ul>
    </nav>

    <div class="menu-nav-footer">
