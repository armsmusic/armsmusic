{# ================================================================
   GALERÍA DEL PRODUCTO — igual al demo de Impact
   (product-gallery del theme.css/theme.js, portado 2026-10-07):
   · <1000px:  media full-bleed + dots con blur (píldora)
   · 1000–1149: carousel horizontal (scroll-snap nativo) +
     thumbnails debajo
   · ≥1150px:  thumbnails verticales a la izquierda + carousel
   · zoom: PhotoSwipe v5 por CDN (lazy, solo al abrir) con
     maxZoomLevel 3 — botón circular abajo-derecha + pinch en iOS
   · custom-cursor: círculo con chevron que sigue al puntero
     (solo pointer:fine)
   El swipe es scroll-snap NATIVO (sin JS custom): funciona en
   móvil y desktop (arrastre/trackpad).
   ================================================================ #}
{% set svgPartial = "svgs/" + svgTipo + ".njk" %}

{% if imagenes and imagenes.length > 0 %}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/photoswipe@5.4.4/dist/photoswipe.css">

<div class="product-gallery product-gallery--mobile-dots product-gallery--desktop-carousel product-gallery--desktop-thumbnails-left product-gallery--mobile-expanded"
  id="producto-gallery" allow-zoom="3">

  <div class="product-gallery__ar-wrapper">
    {# El full-bleed (<1000px) vive en el WRAPPER, no en la media
       list: un contenedor de scroll con márgenes negativos rompe
       el scroll-snap de Chrome (asienta ~20px corto y queda un
       pedazo de la imagen anterior a la vista). #}
    <div class="product-gallery__media-list-wrapper full-bleed md:unbleed" id="gallery-media-wrapper">

      <div class="custom-cursor product-gallery__cursor" aria-hidden="true">
        <div class="circle-button circle-button--fill circle-button--lg">
          <svg role="presentation" focusable="false" width="7" height="10" viewBox="0 0 7 10">
            <path d="m 1 9 4-4-4-4" fill="none" stroke="currentColor" stroke-width="2"></path>
          </svg>
        </div>
      </div>

      {# OJO: el full-bleed NO va en esta clase (el scroll container).
         Un contenedor de scroll con márgenes negativos rompe el
         scroll-snap de Chrome (asienta 20px corto → pedazo de la
         imagen anterior). El bleed vive en el wrapper (ver arms.css). #}
      <div class="product-gallery__media-list scroll-area" id="gallery-media-list"
        role="region" aria-label="Fotos de {{ nombre }}">
        {% for img in imagenes %}
        {% set dims = tamImagenes[img] if tamImagenes else null %}
        <div class="product-gallery__media snap-center" data-media-type="image">
          {# width/height reales (build-time, tamImagenes): evitan CLS en
             la galería y son la fuente de dims para PhotoSwipe v5, que
             NO lee naturalWidth (sin ellos estira la foto al viewport) #}
          <img src="/assets/img/productos/{{ img }}"
            alt="{{ nombre }} foto {{ loop.index }}"
            {% if dims %}width="{{ dims.w }}" height="{{ dims.h }}"{% endif %}
            onerror="this.style.display='none'"
            {% if loop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}>
        </div>
        {% endfor %}
      </div>

      <div class="product-gallery__zoom">
        <button type="button" class="circle-button circle-button--fill" id="btn-zoom-galeria" aria-label="Ampliar imagen">
          <span class="sr-only">Zoom</span>
          <svg role="presentation" fill="none" stroke-width="2" focusable="false" width="15" height="15" viewBox="0 0 15 15">
            <circle cx="7.067" cy="7.067" r="6.067" stroke="currentColor"></circle>
            <path d="M11.4 11.4 14 14" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M7 4v6M4 7h6" stroke="currentColor"></path>
          </svg>
        </button>
      </div>

      {% if imagenes.length > 1 %}
      <div class="page-dots page-dots--blurred product-gallery__dots" id="gallery-dots" aria-label="Ir a la foto">
        {% for img in imagenes %}
        <button type="button" class="tap-area" data-index="{{ loop.index0 }}"
          aria-current="{{ 'true' if loop.first else 'false' }}">
          <span class="sr-only">Ir a la foto {{ loop.index }}</span>
        </button>
        {% endfor %}
      </div>
      {% endif %}

    </div>
  </div>

  {% if imagenes.length > 1 %}
  <div class="product-gallery__thumbnail-list-wrapper">
    <div class="product-gallery__thumbnail-list scroll-area" aria-label="Miniaturas">
      {% for img in imagenes %}
      <button type="button" class="product-gallery__thumbnail" data-index="{{ loop.index0 }}"
        aria-current="{{ 'true' if loop.first else 'false' }}" aria-label="Foto {{ loop.index }}">
        <img src="/assets/img/productos/{{ img }}" alt="" loading="lazy" class="object-contain">
      </button>
      {% endfor %}
    </div>
  </div>
  {% endif %}

</div>

<script>
(function () {
  var list   = document.getElementById('gallery-media-list');
  var items  = list ? Array.prototype.slice.call(list.querySelectorAll('.product-gallery__media')) : [];
  var dots   = Array.prototype.slice.call(document.querySelectorAll('#gallery-dots .tap-area'));
  var thumbs = Array.prototype.slice.call(document.querySelectorAll('.product-gallery__thumbnail'));
  var wrapper = document.getElementById('gallery-media-wrapper');
  var cursor  = document.querySelector('.product-gallery__cursor');

  // ── Índice actual: el item más cerca del centro del viewport ──
  function indexActual() {
    var rect = list.getBoundingClientRect();
    var centro = (rect.left + rect.right) / 2;
    var best = 0, bestDist = Infinity;
    items.forEach(function (it, i) {
      var r = it.getBoundingClientRect();
      var d = Math.abs((r.left + r.right) / 2 - centro);
      if (d < bestDist) { bestDist = d; best = i; }
    });
    return best;
  }

  function marcar(i) {
    dots.forEach(function (d, di) { d.setAttribute('aria-current', di === i ? 'true' : 'false'); });
    thumbs.forEach(function (t, ti) { t.setAttribute('aria-current', ti === i ? 'true' : 'false'); });
    // en ≥1150px los thumbnails van en columna vertical: mantener
    // el activo a la vista
    if (thumbs[i] && window.innerWidth >= 1150) {
      var tr = thumbs[i].getBoundingClientRect();
      var wr = thumbs[i].closest('.product-gallery__thumbnail-list');
      var rr = wr.getBoundingClientRect();
      if (tr.top < rr.top || tr.bottom > rr.bottom) {
        thumbs[i].scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
    }
  }

  // snap-align: center → el target es offsetLeft - medio hueco
  function irA(i) {
    i = Math.max(0, Math.min(items.length - 1, i));
    var it = items[i];
    list.scrollTo({ left: it.offsetLeft - (list.clientWidth - it.offsetWidth) / 2, behavior: 'smooth' });
  }

  if (items.length > 1) {
    var ticking = false;
    list.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        marcar(indexActual());
        ticking = false;
      });
    }, { passive: true });

    dots.forEach(function (d) {
      d.addEventListener('click', function () { irA(parseInt(d.getAttribute('data-index'), 10)); });
    });
    thumbs.forEach(function (t) {
      t.addEventListener('click', function () { irA(parseInt(t.getAttribute('data-index'), 10)); });
    });

    // click en mitad izquierda/derecha de la galería →
    // foto anterior/siguiente (igual al demo; solo pointer:fine,
    // y sin capturar clics en botones)
    list.addEventListener('click', function (e) {
      if (e.target.closest('button, a[href]')) return;
      if (!window.matchMedia('(pointer: fine)').matches) return;
      var r = list.getBoundingClientRect();
      irA(indexActual() + (e.clientX - r.left > r.width / 2 ? 1 : -1));
    });
  }

  // ── Cursor circular con chevron (custom-cursor del demo) ──
  // Sigue al puntero sobre la media-list-wrapper; se esconde al
  // salir y al pasar sobre botones.
  if (cursor && wrapper) {
    wrapper.addEventListener('pointermove', function (e) {
      if (e.target.closest('button, a[href]')) {
        cursor.classList.remove('is-visible');
        return;
      }
      var rect = wrapper.getBoundingClientRect();
      var xCentro = (rect.left + rect.right) / 2;
      cursor.classList.toggle('is-half-start', e.pageX < xCentro);
      cursor.classList.toggle('is-half-end', e.pageX >= xCentro);
      cursor.classList.add('is-visible');
      var x = (e.clientX - rect.left - cursor.clientWidth / 2).toFixed(3);
      var y = (e.clientY - rect.top - cursor.clientHeight / 2).toFixed(3);
      cursor.style.translate = x + 'px ' + y + 'px';
      cursor.style.transform = x + 'px ' + y + 'px';
    }, { passive: true });
    wrapper.addEventListener('pointerleave', function () {
      cursor.classList.remove('is-visible', 'is-half-start', 'is-half-end');
    });
  }

  // ── Zoom: PhotoSwipe v5 por CDN (lazy — solo se descarga al
  //      primer uso). Config igual al demo: fondo opaco, zoom
  //      máx 3, sin flechas/contador propios (bottom-bar custom
  //      con "N / M"). ──
  var lightbox = null, lightboxPromise = null;

  function dataSource() {
    return items.map(function (it) {
      var img = it.querySelector('img');
      // PhotoSwipe v5 NO lee naturalWidth: width/height son obligatorios,
      // si no la imagen se estira al tamaño del viewport (bug de zoom).
      // naturalWidth primero (imagen cargada); fallback al atributo
      // width/height que el build inyecta desde el archivo real.
      var w = img.naturalWidth  || parseInt(img.getAttribute('width'),  10) || 0;
      var h = img.naturalHeight || parseInt(img.getAttribute('height'), 10) || 0;
      return {
        element: it, // v5 usa `element` (no `thumbnailElement`, que era v4)
        src: img.src,
        srcset: img.getAttribute('srcset') || undefined,
        msrc: img.currentSrc || img.src,
        alt: img.alt,
        width:  w || undefined,
        height: h || undefined,
        thumbCropped: false // la miniatura NO está recortada (width:100%, height:auto)
      };
    });
  }

  function getLightbox() {
    if (!lightboxPromise) {
      lightboxPromise = Promise.all([
        import('https://cdn.jsdelivr.net/npm/photoswipe@5/lightbox/+esm'),
        import('https://cdn.jsdelivr.net/npm/photoswipe@5/+esm')
      ]).then(function (mods) {
        var lb = new mods[0].default({
          pswpModule: function () { return Promise.resolve(mods[1].default); },
          bgOpacity: 1,
          maxZoomLevel: parseInt(document.getElementById('producto-gallery').getAttribute('allow-zoom'), 10) || 3,
          arrowPrev: false,
          arrowNext: false,
          counter: false,
          zoom: false,
          closeSVG: '<svg fill="none" xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 56 56"><path d="M56 28C56 12.536 43.464 0 28 0S0 12.536 0 28s12.536 28 28 28 28-12.536 28-28Z" fill="#fff"/><path d="M55.5 28C55.5 12.812 43.188.5 28 .5S.5 12.812.5 28 12.812 55.5 28 55.5 55.5 43.188 55.5 28Z" stroke="#252627" stroke-opacity=".12"/><path d="m22.344 22.343 11.313 11.314m-11.313 0 11.313-11.313" stroke="#252627" stroke-width="2"/></svg>'
        });
        // bottom-bar "N / M" con prev/next (igual al demo)
        lb.on('uiRegister', function () {
          lb.pswp.ui.registerElement({
            name: 'bottom-bar',
            order: 5,
            appendTo: 'wrapper',
            html: '<div class="pagination">' +
              '<button class="pagination__item group" rel="prev" aria-label="Foto anterior"><span class="animated-arrow animated-arrow--reverse"></span></button>' +
              '<span class="pagination__current text-sm">' +
              '<span class="pagination__page">1</span> / <span class="pagination__total"></span></span>' +
              '<button class="pagination__item group" rel="next" aria-label="Foto siguiente"><span class="animated-arrow"></span></button>' +
              '</div>',
            onInit: function (el, pswp) {
              el.querySelector('.pagination__total').innerText = pswp.getNumItems();
              el.querySelector('[rel="prev"]').addEventListener('click', function () { pswp.prev(); });
              el.querySelector('[rel="next"]').addEventListener('click', function () { pswp.next(); });
              pswp.on('change', function () {
                el.querySelector('.pagination__page').innerText = pswp.currIndex + 1;
              });
            }
          });
        });
        lb.init();
        lightbox = lb;
        return lb;
      }).catch(function (err) {
        // CDN caído: permitir reintentar y no bloquear la galería
        lightboxPromise = null;
        console.error('PhotoSwipe no disponible:', err);
        return null;
      });
    }
    return lightboxPromise;
  }

  function abrirZoom(i) {
    getLightbox().then(function (lb) {
      if (lb) lb.loadAndOpen(i, dataSource());
    });
  }

  var btnZoom = document.getElementById('btn-zoom-galeria');
  if (btnZoom) btnZoom.addEventListener('click', function () { abrirZoom(indexActual()); });

  // pinch con scale >1.5 abre el lightbox (igual al demo; solo
  // existe en iOS — en el resto son eventos inertes)
  if (items.length > 0) {
    list.addEventListener('gesturestart', function (e) { e.preventDefault(); }, { passive: false });
    list.addEventListener('gesturechange', function (e) {
      e.preventDefault();
      if (e.scale > 1.5) abrirZoom(indexActual());
    }, { passive: false });
  }
})();
</script>

{% else %}

{# Sin imágenes reales: fallback de SVG sobre gradiente (igual que
   antes de la migración de la galería) #}
<div class="product-gallery">
  <div class="product-gallery__ar-wrapper">
    <div class="product-gallery__media-list-wrapper">
      <div class="product-gallery__media" data-media-type="image"
        style="background: linear-gradient(135deg, {{ g1 }}, {{ g2 }}); border-radius: var(--rounded-sm); display:flex; align-items:center; justify-content:center; aspect-ratio: 1/1;">
        {% include svgPartial %}
      </div>
    </div>
  </div>
</div>

{% endif %}
